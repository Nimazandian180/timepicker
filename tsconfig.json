{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "useDefineForClassFields": true,
    "noEmit": true
  },
  // `demo` is committed and CI builds it, but Vite does not typecheck — without
  // it here, a broken demo ships green. The scratch `demo-real` is deliberately
  // absent: it resolves the date picker through a sibling checkout that only
  // exists on one machine.
  "include": ["src", "demo", "vite.config.ts", "vite.demo.config.ts"]
}
