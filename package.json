{
  "name": "@nimazandian/jalali-timepicker",
  "version": "0.0.0-development",
  "description": "A self-contained, RTL-first Persian time picker for React — analog clock, digital input, range & duration modes, themeable via CSS variables, no Tailwind. Plugs into @aliasadollahi/jalali-datepicker.",
  "type": "module",
  "license": "MIT",
  "author": "Nima Zandian",
  "homepage": "https://github.com/Nimazandian180/timepicker#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nimazandian180/timepicker.git"
  },
  "bugs": {
    "url": "https://github.com/Nimazandian180/timepicker/issues"
  },
  "keywords": [
    "jalali",
    "shamsi",
    "khorshidi",
    "persian",
    "iran",
    "time",
    "timepicker",
    "time-picker",
    "clock",
    "react",
    "rtl",
    "datepicker-plugin"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./plugin": {
      "types": "./dist/plugin/index.d.ts",
      "import": "./dist/plugin.js",
      "require": "./dist/plugin.cjs"
    },
    "./styles.css": "./dist/jalali-timepicker.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json --emitDeclarationOnly",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:timezones": "TZ=UTC vitest run && TZ=America/New_York vitest run && TZ=Asia/Tehran vitest run",
    "check:dist": "node scripts/check-dist.mjs",
    "demo:dev": "vite --config vite.demo.config.ts",
    "demo:build": "vite build --config vite.demo.config.ts",
    "demo:preview": "vite preview --config vite.demo.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "release": "semantic-release",
    "prepublishOnly": "npm run build && npm run check:dist",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "peerDependencies": {
    "@aliasadollahi/jalali-datepicker": ">=1.4.0",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": false
    },
    "@aliasadollahi/jalali-datepicker": {
      "optional": true
    }
  },
  "devDependencies": {
    "@commitlint/cli": "^21.1.0",
    "@commitlint/config-conventional": "^21.1.0",
    "@eslint/js": "^9.17.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.0.8",
    "prettier": "^3.4.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.7",
    "semantic-release": "^25.0.5",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.10"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=18"
  }
}
